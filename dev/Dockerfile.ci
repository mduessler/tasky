FROM python:3.13-slim-bookworm AS build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENV DISPLAY=:99

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /app

RUN python -m pip install --no-cache-dir poetry==2.1.1 poetry-plugin-export && \
    poetry config virtualenvs.create false

COPY pyproject.toml poetry.lock ./
RUN poetry export -f requirements.txt --without-hashes --with dev > requirements.txt

FROM python:3.13-slim-bookworm AS devel

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN mkdir -p /home/tms
ENV HOME=/home/tms

RUN adduser --system --group tms

ENV TMS_HOME=$HOME/web
WORKDIR $TMS_HOME

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ruby \
    ruby-dev \
    && curl -sSfL https://github.com/hadolint/hadolint/releases/download/v2.12.0/hadolint-Linux-x86_64 -o /usr/local/bin/hadolint \
    && chmod +x /usr/local/bin/hadolint \
    && curl -sSfL https://github.com/mvdan/sh/releases/download/v3.10.0/shfmt_v3.10.0_linux_amd64 -o /usr/local/bin/shfmt \
    && chmod +x /usr/local/bin/shfmt \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
