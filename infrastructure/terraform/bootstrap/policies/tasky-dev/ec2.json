{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:DescribeVpcs",
        "ec2:DescribeAddresses",
        "ec2:DescribeAddressesAttribute",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeNatGateways",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribePrefixLists",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeTags",
        "ec2:DescribeVolumes",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeNetworkInterfaces",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:AllocateAddress"],
      "Resource": "arn:aws:ec2:eu-central-1:161313036750:elastic-ip/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:DescribeVpcAttribute",
        "ec2:DeleteVpc"
      ],
      "Resource": "arn:aws:ec2:eu-central-1:161313036750:vpc/*"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateInternetGateway", "ec2:DeleteInternetGateway"],
      "Resource": "arn:aws:ec2:eu-central-1:161313036750:internet-gateway/*"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet"],
      "Resource": [
        "arn:aws:ec2:eu-central-1:161313036750:subnet/*",
        "arn:aws:ec2:eu-central-1:161313036750:vpc/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:AttachInternetGateway", "ec2:DetachInternetGateway"],
      "Resource": [
        "arn:aws:ec2:eu-central-1:161313036750:internet-gateway/*",
        "arn:aws:ec2:eu-central-1:161313036750:vpc/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:ModifySubnetAttribute", "ec2:DeleteSubnet"],
      "Resource": "arn:aws:ec2:eu-central-1:161313036750:subnet/*"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateRouteTable"],
      "Resource": [
        "arn:aws:ec2:eu-central-1:161313036750:route-table/*",
        "arn:aws:ec2:eu-central-1:161313036750:vpc/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRoute",
        "ec2:AssociateRouteTable",
        "ec2:DeleteRouteTable"
      ],
      "Resource": "arn:aws:ec2:eu-central-1:161313036750:route-table/*"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateNatGateway", "ec2:DeleteNatGateway"],
      "Resource": "arn:aws:ec2:eu-central-1:161313036750:natgateway/*"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateVpcEndpoint"],
      "Resource": [
        "arn:aws:ec2:eu-central-1:161313036750:vpc-endpoint/*",
        "arn:aws:ec2:eu-central-1:161313036750:vpc/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:GetInstanceUefiData",
        "ec2:DescribeInstanceAttribute",
        "ec2:ModifyInstanceAttribute",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:eu-central-1:161313036750:instance/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:eu-central-1:161313036750:security-group/*"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:RunInstances"],
      "Resource": [
        "arn:aws:ec2:eu-central-1:161313036750:instance/*",
        "arn:aws:ec2:eu-central-1:161313036750:network-interface/*",
        "arn:aws:ec2:eu-central-1:161313036750:security-group/*",
        "arn:aws:ec2:eu-central-1:161313036750:subnet/*",
        "arn:aws:ec2:eu-central-1:161313036750:volume/*",
        "arn:aws:ec2:eu-central-1::image/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:DisassociateRouteTable"],
      "Resource": [
        "arn:aws:ec2:eu-central-1:161313036750:route-table/*",
        "arn:aws:ec2:eu-central-1:161313036750:subnet/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:DeleteVpcEndpoints"],
      "Resource": "arn:aws:ec2:eu-central-1:161313036750:vpc-endpoint/*"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:DisassociateAddress"],
      "Resource": [
        "arn:aws:ec2:eu-central-1:161313036750:elastic-ip/*",
        "arn:aws:ec2:eu-central-1:161313036750:network-interface/*"
      ]
    }
  ]
}
